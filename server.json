{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.instavar/mcp-server",
  "description": "Make local Remotion videos free, then add an API key for hosted Instavar workflows.",
  "status": "active",
  "repository": {
    "url": "https://github.com/instavar/mcp-server",
    "source": "github"
  },
  "version": "0.5.0",
  "websiteUrl": "https://instavar.com",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@instavar/mcp-server",
      "version": "0.5.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "INSTAVAR_API_KEY",
          "description": "Optional key from https://instavar.com/studio/settings that unlocks hosted workflows.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "INSTAVAR_BASE_URL",
          "description": "Override the Instavar API host. Defaults to https://instavar.com.",
          "isRequired": false,
          "isSecret": false,
          "default": "https://instavar.com"
        }
      ]
    }
  ],
  "_meta": {
    "tools": [
      "get_capabilities",
      "get_creative_guide",
      "list_templates",
      "get_template",
      "get_video_schema",
      "get_example",
      "scaffold_video_spec",
      "get_render_instructions",
      "diagnose_render_error",
      "list_jobs",
      "get_job_status",
      "get_video_state",
      "get_job_metrics",
      "get_cost_summary",
      "create_video_brief",
      "edit_video_brief",
      "approve_job",
      "publish_job",
      "connect_account",
      "connect_account_status"
    ]
  }
}
